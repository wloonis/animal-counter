apiVersion: apps/v1
kind: Deployment
metadata:
  name: video-compress-fast
  namespace: "{{ app_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: video-compress-fast
  template:
    metadata:
      labels:
        app: video-compress-fast
    spec:
      restartPolicy: Always
      containers:
      - name: ffmpeg
        image: lscr.io/linuxserver/ffmpeg:latest
        imagePullPolicy: IfNotPresent
        resources:
          requests:
            cpu: "100m"
            memory: "128Mi"
          limits:
            cpu: "500m"
            memory: "512Mi"
        command:
          - /bin/sh
          - -c
          - |
            while true; do
              echo "=== Début cycle compression ==="

              # Trim tail (no-detection queue) from the compressed archive.
              # TRIM_TAIL is templated from the shared delay_last_class var (default 180 s),
              # the same value the app uses to stop recording — single source of truth.
              TRIM_TAIL={{ delay_last_class | default(180) }}

              # Total-size budget (GB) for /videos. The guard below deletes
              # oldest count* files until usage drops below this value.
              VIDEO_BUDGET_GB={{ video_budget_gb | default(40) }}

              for f in /videos/tocompress-*; do
                [ -e "$f" ] || continue

                out="/videos/$(basename "$f" | sed 's/^tocompress-//; s/-#[0-9]*\.mp4$/.mp4/')"

                # Compute input duration; trim the last TRIM_TAIL seconds.
                DUR=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$f")

                if [ -z "$DUR" ] || ! awk "BEGIN{ exit !($DUR > $TRIM_TAIL) }"; then
                  # Short or unreadable clip: keep the whole file, skip -t.
                  echo "WARN: trim skipped for $f (DUR=${DUR:-empty}, TRIM_TAIL=$TRIM_TAIL)"
                  ffmpeg -y -i "$f" \
                    -vf "scale=640:-2" \
                    -c:v libx264 \
                    -preset ultrafast \
                    -crf 23 \
                    -c:a aac \
                    -b:a 64k \
                    "$out"
                else
                  KEEP=$(awk "BEGIN{ print ($DUR) - $TRIM_TAIL }")
                  echo "Compress+trim $f: DUR=$DUR TRIM_TAIL=$TRIM_TAIL KEEP=$KEEP"
                  ffmpeg -y -i "$f" -t "$KEEP" \
                    -vf "scale=640:-2" \
                    -c:v libx264 \
                    -preset ultrafast \
                    -crf 23 \
                    -c:a aac \
                    -b:a 64k \
                    "$out"
                fi

                rm -f "$f"
              done

              cd /videos
              ls -t count* 2>/dev/null | awk 'NR>30' | xargs -r rm -f
              # Restreint aux .mp4 uniquement (avant: find . -type f -size +2G supprimait
              # tout fichier >2 Go, y compris un dataset/modèle éventuel dans /videos).
              find . -maxdepth 1 -type f -name '*.mp4' -size +2G -delete

              # --- Total-size guard (issue #43 P1) ---
              # Absolute backstop: delete oldest count* (compressed outputs) by mtime
              # until total /videos usage drops below VIDEO_BUDGET_GB.
              # Deletes ONLY count* files — NEVER tocompress-* or any input.
              # Edge case: if tocompress-* alone exceeds the budget, the guard
              # cannot reduce those (it would delete inputs); a warning is logged.
              BUDGET_MB=$((VIDEO_BUDGET_GB * 1024))
              while [ "$(du -sm /videos | awk '{print $1}')" -gt "$BUDGET_MB" ]; do
                OLDEST=$(ls -t count* 2>/dev/null | tail -1)
                if [ -z "$OLDEST" ]; then
                  echo "WARN: /videos exceeds budget (${VIDEO_BUDGET_GB} GB) but no count* files left to delete — tocompress-* or other files may be the cause"
                  break
                fi
                echo "Budget guard: deleting oldest $OLDEST"
                rm -f "$OLDEST"
              done

              echo "=== Fin cycle, pause 10 min ==="
              sleep 600
            done
        volumeMounts:
        - name: videos
          mountPath: /videos

      volumes:
      - name: videos
        hostPath:
          path: {{ files_path }}
          type: Directory