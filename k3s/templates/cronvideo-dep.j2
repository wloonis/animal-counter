apiVersion: apps/v1
kind: Deployment
metadata:
  name: video-compress-fast
  namespace: "{{ app_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: video-compress-fast
  template:
    metadata:
      labels:
        app: video-compress-fast
    spec:
      restartPolicy: Always
      containers:
      - name: ffmpeg
        image: lscr.io/linuxserver/ffmpeg:latest
        imagePullPolicy: IfNotPresent
        resources:
          requests:
            cpu: "100m"
            memory: "128Mi"
          limits:
            cpu: "500m"
            memory: "512Mi"
        command:
          - /bin/sh
          - -c
          - |
            while true; do
              echo "=== Début cycle compression ==="

              for f in /videos/tocompress-*; do
                [ -e "$f" ] || continue

                out="/videos/$(basename "$f" | sed 's/^tocompress-//')"

                ffmpeg -y -i "$f" \
                  -vf "scale=640:-2" \
                  -c:v libx264 \
                  -preset ultrafast \
                  -crf 23 \
                  -c:a aac \
                  -b:a 64k \
                  "$out"

                rm -f "$f"
              done

              cd /videos
              ls -t count* 2>/dev/null | awk 'NR>50' | xargs -r rm -f
              find . -type f -size +2G -delete

              echo "=== Fin cycle, pause 10 min ==="
              sleep 600
            done
        volumeMounts:
        - name: videos
          mountPath: /videos

      volumes:
      - name: videos
        hostPath:
          path: {{ files_path }}
          type: Directory