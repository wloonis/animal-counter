apiVersion: batch/v1
kind: Job
metadata:
  name: countingapp-test
  namespace: "{{ app_namespace }}"
spec:
  ttlSecondsAfterFinished: 30
  backoffLimit: 0
  template:
    metadata:
      labels:
        app: countingapp-test
    spec:
      restartPolicy: Never
      terminationGracePeriodSeconds: 0
      containers:
      - name: countingapp-test
        image: "{{ app_name }}:{{ app_version }}"
        args: ["test"]
        imagePullPolicy: Never
        volumeMounts:
        - name: dev-app
          mountPath: /app
        - name: filebrowser
          mountPath: /files
        - name: docker-sock
          mountPath: /var/run/docker.sock
        securityContext:
          privileged: true
        resources:
          requests:
            cpu: "500m"
            memory: "2Gi"
            nvidia.com/gpu: 1
          limits:
            cpu: "2"
            memory: "4Gi"
            nvidia.com/gpu: 1
      volumes:
      - name: dev-app
        hostPath:
          path: "{{ app_path }}"
          type: Directory
      - name: filebrowser
        hostPath:
          path: "{{ files_path }}"
          type: Directory
      - name: docker-sock
        hostPath:
          path: /var/run/docker.sock