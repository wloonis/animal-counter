apiVersion: batch/v1
kind: Job
metadata:
  name: "build-engine"
  namespace: "{{ app_namespace }}"
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 120
  template:
    spec:
      restartPolicy: Never
      containers:
      - name: "build-engine"
        image: "{{ app_name }}:{{ app_version }}"
        # Use the hostPath /app/entrypoint.sh (always current, rsync'd from the
        # repo) instead of the baked /entrypoint.sh — so entrypoint.sh changes
        # (e.g. the $MODEL_NAME build-engine logic) take effect WITHOUT an image
        # rebuild for the build-engine path. The serve path doesn't use
        # $MODEL_NAME (just `python3 src/main.py` via hostPath /app/src), so the
        # stale baked entrypoint is fine for serving.
        command: ["/app/entrypoint.sh", "build-engine"]
        imagePullPolicy: Never
        # Model artifacts are named after the dataset dir (basename of
        # TRAINING_PROJECT_DIR). The entrypoint's build-engine mode reads this
        # to pick the right .onnx -> .engine pair.
        env:
        - name: MODEL_NAME
          value: "{{ model_name }}"
        volumeMounts:
        - name: dev-app
          mountPath: /app
        - name: docker-sock
          mountPath: /var/run/docker.sock
        securityContext:
          privileged: true
        # Request GPU resource
        resources:
          requests:
            cpu: "500m"
            memory: "2Gi"
            nvidia.com/gpu: 1
          limits:
            cpu: "2"
            memory: "4Gi"
            nvidia.com/gpu: 1
      volumes:
      - name: dev-app
        hostPath:
          path: "{{ app_path }}"
          type: Directory
      - name: docker-sock
        hostPath:
          path: /var/run/docker.sock