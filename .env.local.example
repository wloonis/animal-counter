# =============================================================================
# Animal Counter — control-machine environment example
# =============================================================================
# Copy this file to .env.local (repo root) and fill in real values.
# .env.local is gitignored (it holds secrets: passwords, API keys, tokens).
# This example is versioned and contains ONLY placeholders — no real secrets.
#
# Consumed by: scripts/*.sh (sourced), ansible/inventory/jetsons.yml and
# ansible/group_vars/all.yml (via lookup('env', ...)).
# =============================================================================

# ─── Secrets (NEVER commit real values) ─────────────────────────────────────
JETSON_USER=nano-counter                 # SSH user on the Jetson
JETSON_PASSWORD=change-me                # SSH password (used by sshpass)
JETSON_HOTSPOT_PASSWORD=change-me         # WiFi hotspot password
FILEBROWSER_ADMIN_PASSWORD=change-me     # filebrowser admin password (use a strong password)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx    # GitHub PAT (only if you push from this machine)
TRAINING_ROBOFLOW_API_KEY=xxxxxxxx       # Roboflow API key (only for model training)

# ─── Jetson discovery (network scan by jetson_discover.sh) ──────────────────
# WIFI_NETWORK is the CIDR scanned by nmap for hosts with port 22 open.
WIFI_NETWORK=192.168.0.0/24
WIFI_NETWORK_HOTSPOT=192.168.100.0/24    # network of the Jetson's WiFi hotspot
BOX_CONNECTION=TP-Link_49F0             # informational: your home/box SSID
# JETSON_IP is NOT set here — it is discovered by jetson_discover.sh and cached
# in /tmp/jetson_env.sh. You may force it for a known device:
# JETSON_IP=192.168.0.180

# ─── Jetson WiFi hotspot (offline operation) ────────────────────────────────
JETSON_HOTSPOT_NAME=JetsonHotspot
JETSON_HOTSPOT_SSID=JetsonHotspot
JETSON_HOTSPOT_INTERFACE=wlP1p1s0
JETSON_HOTSPOT_IP=192.168.100.1/24

# ─── Jetson Ethernet (informational; discovery overrides this) ──────────────
JETSON_ETH_NAME=JetsonEthernet
JETSON_ETH_INTERFACE=enP8p1s0
JETSON_ETH_IP=192.168.50.10/24
JETSON_ETH_GATEWAY=192.168.50.1
JETSON_ETH_DNS=192.168.50.1

# ─── Application (countingapp) ───────────────────────────────────────────────
APP_NAMESPACE=countingapp-dev
APP_NAME=countingapp
APP_VERSION=local
APP_PORT=31501
LOCAL_APP_PATH=/mnt/c/Dev/ai/animal-counter/app   # app path on the control machine
APP_PATH=/data/orin/git/animal-counting/app       # app path on the Jetson (hostPath /app)
DOCKER_PATH=/data/orin/docker/
FILES_PATH=/data/orin/files/                       # videos / dataset dir on the Jetson
VIDEO_DEVICE=/dev/video0
IMAGE_NAME=countingapp
IMAGE_TAG=local
MAX_LOG_FILES=50
LOG_MAX_SIZE=100M

# ─── Docker registry (optional local registry on the Jetson) ───────────────
REGISTRY_NAME=registry
REGISTRY_PORT=5000
REGISTRY_DATA_DIR=/opt/registry/data
REGISTRY_IMAGE=registry:2

# ─── Filebrowser ────────────────────────────────────────────────────────────
FILEBROWSER_PORT=8080
FILEBROWSER_BASE_URL=/
FILEBROWSER_CACHE_DIR=/data/tmp
FILEBROWSER_DATABASE=/data/database.db
FILEBROWSER_SRV_PATH=/srv
FILEBROWSER_ADMIN_USERNAME=admin
FILEBROWSER_IMAGE=ghcr.io/gtsteffaniak/filebrowser:stable
FILEBROWSER_CONFIG_PATH=/data/orin/git/animal-counting/config/filebrowser/

# ─── K3s ─────────────────────────────────────────────────────────────────────
K3S_APP_PATH=/data/orin/git/animal-counting/k3s    # where rendered manifests are written

# ─── Model training (scripts/training_model.sh → build_model.yml) ───────────
TRAINING_PROJECT_DIR=/mnt/c/Dev/ai/animal-counter/dataset/mike
TRAINING_ROBOFLOW_WORKSPACE=swenn
TRAINING_ROBOFLOW_PROJECT=pig-count-1sb8c
TRAINING_ROBOFLOW_VERSION=7
TRAINING_ROBOFLOW_FORMAT=yolo26
TRAINING_DATA_PATH=./data.yaml
TRAINING_MODEL=yolo26s.pt
TRAINING_EPOCHS=300
TRAINING_IMGSZ=640
TRAINING_DEVICE=0