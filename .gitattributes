# Force LF line endings for text files.
# The repo deploys to Linux (Jetson Orin / k3s containers); CRLF breaks
# shell scripts (set -euo pipefail\r) and templates rendered to shell/yaml.
# Binaries are left untouched (only explicit text extensions are normalized).
*.sh    text eol=lf
*.j2    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.cfg   text eol=lf
*.conf  text eol=lf
*.env   text eol=lf
*.txt   text eol=lf
Dockerfile  text eol=lf
entrypoint.sh text eol=lf