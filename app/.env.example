# =============================================================================
# Animal Counter — configuration example
# =============================================================================
# Copy this file to app/.env and adjust to your environment.
# (app/.env is gitignored; these values are the validated defaults for the
#  pig-counting use case: fixed camera, 30fps, pigs counted right->left.)
# Every key here is read in app/src/settings.py; the value shown is the
# validated production value (also the settings.py default unless noted).
# =============================================================================

# ─── Input source ───────────────────────────────────────────────────────────
INPUT_SOURCE=CAMERA                # CAMERA | VIDEO
VIDEO_PATH=/dev/video0             # device (CAMERA) or file path (VIDEO)

# ─── Output resolution ──────────────────────────────────────────────────────
OUTPUT_WIDTH=640
OUTPUT_HEIGHT=480
OUTPUT_SCREEN_WIDTH=1024
OUTPUT_SCREEN_HEIGHT=600

# ─── FPS ────────────────────────────────────────────────────────────────────
FPS_OUTPUT=30                      # camera/video is 30fps; do not change

# ─── Counting line ───────────────────────────────────────────────────────────
# Orientation: vertical (default = current behavior, line is vertical x=const,
#   pigs cross right->left) or horizontal (line is horizontal y=const, pigs cross
#   down->up). +1 = crossing-axis position DECREASING past the line:
#   vertical  +1 = right->left = LEFT   (−1 = left->right = RIGHT)
#   horizontal +1 = down->up = UP      (−1 = up->down = DOWN)
COUNTING_LINE_ORIENTATION=vertical
# Offset of the counting line along the perpendicular axis, as a SIGNED percent
#   of the frame width (vertical) or height (horizontal):
#   vertical   -> x = img_width/2 + img_width * OFFSET/100
#   horizontal -> y = img_height/2 + img_height * OFFSET/100
#   Loose sanity range -300..300 (rejected outside / if non-int/bool in main.py).
#   The AUTHORITATIVE bound is the line staying inside the image with a 200px
#   margin on both edges (vertical x in [200, W-200]; horizontal y in [200,
#   H-200]), enforced by clamping the computed position at use-time in
#   counting.py + rendering.py since the frame size is only known at runtime.
#   Existing 0..100 values stay valid (a sub-range, always in-bounds).
#   10 -> x ~= 384 on a 640px frame (vertical).
OFFSET_PERCENT_COUNTING_LINE=10

# ─── Detection confidence ───────────────────────────────────────────────────
PIG_CONFIDENCE_THRESHOLD=0.6           # min conf to count a pig
PIG_CONFIDENCE_THRESHOLD_START_VIDEO=0.8  # higher threshold for the first frames
CONF_THRESH=0.5                        # YOLO raw conf (pre-tracker)
IOU_THRESHOLD=0.45                     # YOLO NMS IoU

# ─── Ignored image regions (px) ─────────────────────────────────────────────
TOP_IGNORE=100                     # ignore detections in the top band
BOTTOM_IGNORE=50                   # ignore detections in the bottom band

# ─── Visualization ──────────────────────────────────────────────────────────
DRAW_TRACKING=False                # draw tracking boxes/IDs on output
CENTROID_TRACKING=True
BOX_TRACKING=True

# ─── Output / logging ───────────────────────────────────────────────────────
OUTPUT_VIDEO_PATH=/files           # where annotated output is written
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ─── Learning mode (optional) ───────────────────────────────────────────────
DATASET_DIR=/files/dataset
CAPTURE_INTERVAL=1
MAX_LEARNING_DURATION=600
MAX_VIDEO_DURATION=3600

# ─── OC-SORT tracker tuning (anti ID-switch near the counting line) ─────────
# lost_track_buffer: frames a lost track is kept alive (scaled by frame_rate).
#   20 ~= 0.67s at 30fps. Higher survives longer occlusions but can re-bind
#   dead tracks to wrong detections (over-counting). Keep 20.
TRACKER_LOST_TRACK_BUFFER=20
TRACKER_FRAME_RATE=30.0            # used to scale the lost buffer into time
# minimum_consecutive_frames before a stable tracker_id is assigned.
#   5 ~= 0.17s: filters ephemeral tracks (a human walking through, noise) that
#   would cross the line and cause a false +/-1. 3 was too permissive.
TRACKER_MIN_CONSECUTIVE_FRAMES=5
TRACKER_MIN_IOU_THRESHOLD=0.3      # detection/track association IoU
TRACKER_DIRECTION_CONSISTENCY_WEIGHT=0.25  # OCM direction term weight
# high_conf_det_threshold: detections below this are dropped by the tracker
#   BEFORE association. 0.6 keeps only confident pigs (0.5 fed noisy dets that
#   spawned ghost tracks). The OCR 2nd-chance still rescues occluded ones.
TRACKER_HIGH_CONF_THRESHOLD=0.6
TRACKER_DELTA_T=3                  # OCM velocity-direction temporal window
# Association similarity function (trackers >= 2.5.0, iou= kwarg).
#   giou = Generalized IoU. ACTIVATED by default to reduce ID-switch on
#     occlusions at the counting line (our primary defect). Score range [-1,1]
#     != [0,1] (standard IoU), so TRACKER_MIN_IOU_THRESHOLD may need lowering
#     if validation regresses; re-validate 4/4 after any change.
#   iou  = standard IoU = IDENTICAL pre-2.5.0 behavior; safe revert target.
COUNTING_TRACKER_IOU=giou

# ─── Counting ID-switch recovery guard ──────────────────────────────────────
# LOST_BUFFER_FRAMES: GLOBAL expiration age of lost_tracks (memory
#   housekeeping). Keep LONG (60 ~= 2s) so the guard can fuse a lost "in" with
#   a brand-new left-side ID even after a long occlusion at the line (critical
#   for videos like #35). Lowering it under-counts.
COUNTING_LOST_BUFFER_FRAMES=60
# Lost "in" track must be within this horizontal band (px) of the line.
COUNTING_REASSOC_LINE_BAND=200
# Max horizontal/vertical distance (px) between new ID and lost track for fusion.
COUNTING_REASSOC_MAX_DIST_X=120
COUNTING_REASSOC_MAX_DIST_Y=80
# GUARD_MAX_AGE: max age (frames) of a lost "in" track ELIGIBLE for guard fusion.
#   Keep SHORT (15 ~= 0.5s) so a stale lost "in" from a DIFFERENT pig (or one
#   already crossed under another ID) is not fused with a new left-side ID
#   (the #30/#11 false +1). Distinct from LOST_BUFFER_FRAMES (global expiration).
COUNTING_GUARD_MAX_AGE=15

# ─── Resurrection guard (Pattern B, filet) ───────────────────────────────────
# An already-known ID reappearing FAR from its last position after a brief
#   absence is an OC-SORT re-ID (right->left jump would fire a false crossed
#   LEFT). Trigger on the POSITION JUMP (primary) + small min absence age
#   (secondary, jitter filter), then reset the area list with no count change.
#   Never triggered on the real cases (jumps < 150px) but harmless; kept as a
#   safety net for huge re-ID jumps.
COUNTING_RESURRECTION_MIN_JUMP=150
COUNTING_RESURRECTION_THRESHOLD=5

# ─── REID-SUPPRESS (the #35 fix) ────────────────────────────────────────────
# A known ID (in area_in, not yet counted) reappears on the LEFT after an
#   absence, while ANOTHER ID that APPEARED during its absence recently crossed
#   LEFT: that other ID is a re-ID of the same (already-counted) pig -> suppress
#   the +1. A legitimate occluded crossing has no other ID appearing during the
#   absence, so it fires normally.
COUNTING_REID_WINDOW=15            # max age (frames) of a crossing to be "recent"
COUNTING_REID_MIN_AGE=3            # min absence (frames) for an ID to be suspicious

# ─── Hysteresis (DISABLED) ──────────────────────────────────────────────────
# Dead-band (px) around the line; a crossing is counted only past this margin.
#   WARNING: a non-zero value can SWALLOW a legitimate crossed RIGHT (pig going
#   left->right but staying in the band) and leave its later crossed LEFT
#   uncompensated = over-count. Keep 0 (validated on #18).
COUNTING_HYSTERESIS_PX=0

# ─── Mirror guard ───────────────────────────────────────────────────────────
# Mode: off | log | enforce. log = detect & log only (default, no count change).
#   Found 0 candidates on the validation set -> left in log (inert).
COUNTING_MIRROR_GUARD=log
COUNTING_MIRROR_MAX_AGE=15         # max age (frames) of a lost "out" track
COUNTING_MIRROR_LINE_BAND=100      # band (px) of the line for the lost "out"
COUNTING_MIRROR_NEW_BAND=120       # band (px) of the line for the new right ID
COUNTING_MIRROR_MAX_DIST_Y=60      # max vertical distance (px) for fusion