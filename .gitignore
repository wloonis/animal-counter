# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.old
old/
video/
examples/

#IA
dataset/
my_model.*

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
.vibe/
.agents/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Tests / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# Type checkers
.mypy_cache/
.pyre/
.pytype/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs
*.log

# IDE / editors
.vscode/
ù*.swp
*.swo

# Secrets / env vars
.env.*
*.env
# Keep the example template versionable
!.env.example
!.env.local.example

# Database files
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db

# PyInstaller
*.manifest
*.spec

# Data (optionnel)
data/
datasets/

# Keep the Android Kotlin `data` package (BL-65) — the broad `data/` rule
# above would otherwise ignore it.
!android/app/src/main/java/com/animalcounter/data/

# Archon cross-run state (never commit)
.archon/state/
.archon-relay/
.pi-loop.json
.pi-loop.json.lock

# Docker image saves (offline transfer — ~20 Go tar, never commit)
save/

# Local backups / temp saves (never commit)
*.sav

# Validation run artifact (generated by validate_on_jetson.sh)
validation-report.json

# Local presentation deck (never committed — speaker support only)
PRESENTATION.md

# Validation videos (large, not committed) — except the standard-mode reference video
# (validate_on_jetson.sh without --full uses config.json "reference_video")
validation/videos/*.mp4
!validation/videos/validation-1-#9.mp4

# Android (BL-65)
/android/local.properties
/android/.gradle/
/android/build/
/android/app/build/
/android/captures/
/android/.idea/
/android/*.iml
/android/app/*.iml
